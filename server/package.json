{
  "name": "github-actions-access-manager",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "test": "node --experimental-transform-types --import tsx --experimental-test-module-mocks --test test/**.test.ts",
    "start": "node --experimental-transform-types --import tsx src/server.ts",
    "build": "npx npm-run-all build:*",
    "build:server": "tsup src/server.ts",
    "build:cloudflare-worker": "tsup deployments/cloudflare/index.ts",
    "build:aws-lambda": "tsup deployments/aws/lambda-handler.ts",
    "build:vercel-function": "tsup deployments/vercel/api/index.ts",
    "build:netlify-function": "tsup deployments/netlify/functions/index.ts",
    "build:docker-container": "docker build -t localhost/github-access-token-server:latest ."
  },
  "workspaces": [
    "deployments/cloudflare",
    "deployments/aws",
    "deployments/vercel",
    "deployments/netlify"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/rest": "^22.0.1",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@octokit/types": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-node": "^11.1.0",
    "expect": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": "24.x"
  }
}
